# Percent-encode special characters in URI usernames/passwords (@ becomes %40).
MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=sentinel-project
MONGODB_DB=sentinel_project
DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@db.PROJECT.supabase.co:5432/postgres
SOURCE_SCHEMA=public
SENTINEL_DATA_DIR=/absolute/path/to/sentinel_data
